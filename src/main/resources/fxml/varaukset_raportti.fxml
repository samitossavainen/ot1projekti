<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0"
      style="-fx-background-color: #F7F9F2;"
      VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mokkikodit.controller.VarausRaporttiController">

    <!-- PADDING -->
    <padding>
        <Insets bottom="20.0"
                left="20.0"
                right="20.0"
                top="20.0" />
    </padding>

    <children>

        <Button mnemonicParsing="false"
                onAction="#goBack"
                text="&lt;- Palaa takaisin"
                style="-fx-base: #8A8A8A; -fx-text-fill: white;"/>

        <HBox alignment="CENTER_LEFT"
              spacing="10.0">

            <children>

                <Label text="VARAUSRAPORTTI"
                       textFill="#574520">

                    <font>
                        <Font name="System Bold"
                              size="24.0" />
                    </font>

                </Label>

            </children>

        </HBox>

        <VBox prefWidth="100.0"
              spacing="10.0">

            <children>

                <!-- PÄIVÄMÄÄRÄT -->
                <HBox alignment="CENTER_LEFT"
                      spacing="10.0">

                    <children>

                        <DatePicker fx:id="alkuDatePicker"
                                    prefWidth="150.0"
                                    promptText="Alku" />

                        <Label text="-"
                               HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets top="5.0" />
                            </padding>

                        </Label>

                        <DatePicker fx:id="loppuDatePicker"
                                    prefWidth="150.0"
                                    promptText="Loppu" />

                    </children>

                    <VBox.margin>
                        <Insets />
                    </VBox.margin>

                </HBox>

            </children>

        </VBox>

        <HBox alignment="CENTER_LEFT"
              spacing="26.0">

            <children>

                <VBox>

                    <children>

                        <Label text="Tila:" />

                        <ComboBox fx:id="tilaComboBox"
                                  prefWidth="150.0" />

                    </children>

                </VBox>

                <VBox>

                    <children>

                        <Label text="Mökki:" />

                        <ComboBox fx:id="mokkiComboBox"
                                  prefWidth="150.0" />

                    </children>

                </VBox>

                <VBox>

                    <children>

                        <Label text="Asiakas:" />

                        <ComboBox fx:id="asiakasComboBox"
                                  prefWidth="150.0" />

                    </children>

                </VBox>

            </children>

        </HBox>

        <!-- TAULU -->
        <TableView fx:id="tableRaportti"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="varausIdCol"
                             text="Varaus ID" />

                <TableColumn fx:id="mokkiCol"
                             text="Mökki" />

                <TableColumn fx:id="asiakasCol"
                             text="Asiakas" />

                <TableColumn fx:id="alkuCol"
                             text="Alku" />

                <TableColumn fx:id="loppuCol"
                             text="Loppu" />

                <TableColumn fx:id="tilaCol"
                             text="Tila" />

                <TableColumn fx:id="summaCol"
                             prefWidth="113.0"
                             text="Kokonaishinta" />

            </columns>

        </TableView>

        <!-- YKSITYISKOHDAT -->
        <VBox spacing="10.0">

            <HBox spacing="10.0">

                <children>

                    <Label text="YHTEENVETO"
                           textFill="#574520">

                        <font>
                            <Font name="System Bold"
                                  size="20.0" />
                        </font>

                    </Label>

                </children>

            </HBox>

            <Separator prefWidth="200.0" />

            <GridPane hgap="10.0"
                      vgap="8.0">

                <children>

                    <Label text="Varauksia yhteensä:" />

                    <Label text="Varattuja:"
                           GridPane.rowIndex="1" />

                    <Label text="Peruttuja:"
                           GridPane.rowIndex="2" />

                    <Label text="Kokonaissumma:"
                           GridPane.rowIndex="3" />

                    <Label fx:id="yhteensaLabel"
                           text="0"
                           GridPane.columnIndex="1" />

                    <Label fx:id="varatutLabel"
                           text="0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1" />

                    <Label fx:id="perututLabel"
                           text="0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2" />

                    <Label fx:id="kokonaissummaLabel"
                           text="0.00 €"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3" />

                </children>

                <columnConstraints>
                    <ColumnConstraints />
                    <ColumnConstraints />
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>

            </GridPane>

        </VBox>

    </children>

</VBox>