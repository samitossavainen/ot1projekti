<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10.0" style="-fx-background-color: #F7F9F2;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mokkikodit.controller.MokkiRaporttiController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>

        <Button mnemonicParsing="false" onAction="#goBack" style="-fx-base: #8A8A8A; -fx-text-fill: white;" text="&lt;- Palaa takaisin" />

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="MÖKKIRAPORTTI" textFill="#574520">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <VBox prefWidth="100.0" spacing="10.0">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <DatePicker fx:id="alkuDatePicker" promptText="Alku" />
                        <Label text="-" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets top="5.0" />
                            </padding>
                        </Label>
                        <DatePicker fx:id="loppuDatePicker" promptText="Loppu" />                        <Label text="Tila:" />
                        <ComboBox fx:id="tilaComboBox" prefWidth="150.0" />
                        <Label text="Mökki:" />
                        <ComboBox fx:id="mokkiComboBox" prefWidth="150.0" />
                    </children>
                </HBox>

            </children>
        </VBox>

        <!-- TABLE -->
        <TableView fx:id="tableRaportti" VBox.vgrow="ALWAYS">

            <columns>

                <!-- FIXED: matches controller cabinCol -->
                <TableColumn fx:id="cabinCol" prefWidth="62.0" text="Mökin ID" />

                <TableColumn fx:id="nameCol" prefWidth="48.0" text="Nimi" />
                <TableColumn fx:id="addressCol" prefWidth="124.0" text="Osoite" />
                <TableColumn fx:id="capacityCol" prefWidth="86.0" text="Kapasiteetti" />
                <TableColumn fx:id="priceCol" text="Hinta" />
                <TableColumn fx:id="roomsCol" text="Huoneet" />
                <TableColumn fx:id="bathroomsCol" text="Vessat" />
                <TableColumn fx:id="statusCol" text="Tila" />
                <TableColumn fx:id="varauksetCol" text="Varauksia" />
                <TableColumn fx:id="vuorokaudetCol" text="Vuorokaudet" />

            </columns>
        </TableView>

        <!-- DETAIL -->
        <VBox spacing="10.0">
            <HBox spacing="10.0">
                <children>
                    <Label text="YHTEENVETO" textFill="#574520">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </children>
            </HBox>

            <Separator prefWidth="200.0" />

            <GridPane hgap="10.0" vgap="8.0">

                <children>
                    <Label text="Mökkejä yhteensä:" />
                    <Label text="Varauksia yhteensä:" GridPane.rowIndex="1" />
                    <Label text="Vuorokausia yhteensä:" GridPane.rowIndex="2" />
                    <Label text="Kokonaistulot:" GridPane.rowIndex="3" />

                    <Label fx:id="mokkejaYhteensaLabel" text="-" GridPane.columnIndex="1" />
                    <Label fx:id="varauksiaYhteensaLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label fx:id="vuorokausiaYhteensaLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label fx:id="kokonaistulotLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </children>
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>

            </GridPane>
        </VBox>

    </children>
</VBox>
